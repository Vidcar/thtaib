{
  "name": "local-ai-workbench-desktop",
  "productName": "Local AI Workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Local AI Workbench desktop shell",
  "author": "Vidcar",
  "type": "module",
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "build": "pnpm run typecheck && node scripts/check-sse-terminal-snapshot.mjs && node scripts/check-model-settings.mjs && vite build",
    "package": "pnpm run build && electron-builder --win nsis",
    "generate:shared-contracts": "openapi-typescript ../backend/contracts/openapi.json -o src/generated/shared-contracts/openapi.d.ts --root-types"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vite-plugin-electron": "1.1.2"
  }
}
