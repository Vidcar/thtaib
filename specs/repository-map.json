    {
      "id": "contract-tests",
      "state": "unbound",
      "path": null,
      "kind": "directory",
      "owner_spec": "specs/contracts.md",
      "required_before": "First shared contract implementation"
    },
    {
      "id": "integration-tests",
      "state": "unbound",
      "path": null,
      "kind": "directory",
      "owner_spec": "specs/verification.md",
      "required_before": "First live runtime/worker implementation"
    },
    {
      "id": "import-boundary-check",
      "state": "unbound",
      "path": null,
      "kind": "file",
      "owner_spec": "specs/architecture.md",
      "required_before": "First concrete inter-module dependencies"
    }
